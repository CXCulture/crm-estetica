// ============================================================================
// SERVIÇO DE INTEGRAÇÃO COM BANCO DE DADOS (SUPABASE)
// ============================================================================
export const AppointmentService = {
  async fetchAppointments(): Promise<Appointment[]> {
    try {
      const { data, error } = await supabase
        .from('appointments')
        .select(`
          id,
          service_category,
          service_name,
          start_time,
          status,
          fluence_jcm2,
          pulse_ms,
          total_shots,
          spot_size_mm,
          clients (
            name,
            phone,
            fitzpatrick,
            uses_acids,
            medical_alerts,
            notes
          )
        `)
        .order('start_time', { ascending: true });

      if (error || !data) throw error;

      return data.map((item: any) => {
        const startTime = new Date(item.start_time);
        return {
          id: item.id,
          clientName: item.clients?.name || 'Cliente Sem Nome',
          clientPhone: item.clients?.phone || '',
          serviceCategory: item.service_category,
          serviceName: item.service_name,
          date: startTime.toISOString().split('T')[0],
          time: startTime.toTimeString().slice(0, 5),
          status: item.status,
          laserParams: item.fluence_jcm2 ? {
            fluenceJcm2: item.fluence_jcm2,
            pulseMs: item.pulse_ms,
            totalShots: item.total_shots,
            spotSizeMm: item.spot_size_mm
          } : undefined,
          anamnesis: {
            fitzpatrick: item.clients?.fitzpatrick || 'III',
            usesPhotosensitiveAcids: item.clients?.uses_acids || false,
            medicalAlerts: item.clients?.medical_alerts || [],
            notes: item.clients?.notes || ''
          }
        };
      });
    } catch (err) {
      console.warn('Supabase offline ou não configurado. Utilizando dados locais de exemplo.');
      return initialAppointments;
    }
  }
};

