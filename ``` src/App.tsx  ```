// ============================================================================
// TIPOS E INTERFACES (TypeScript)
// ============================================================================
export type FitzpatrickType = 'I' | 'II' | 'III' | 'IV' | 'V' | 'VI';
export type AppointmentStatus = 'confirmada' | 'alerta_clinico' | 'pos_laser_pendente' | 'concluido' | 'cancelado';
export type ServiceCategory = 'laser' | 'facial_catia' | 'manual';

export interface LaserParams {
  fluenceJcm2: number;
  pulseMs: number;
  totalShots: number;
  spotSizeMm: number;
}

export interface Anamnesis {
  fitzpatrick: FitzpatrickType;
  usesPhotosensitiveAcids: boolean;
  medicalAlerts: string[];
  notes: string;
}

export interface Appointment {
  id: string;
  clientName: string;
  clientPhone: string;
  serviceCategory: ServiceCategory;
  serviceName: string;
  date: string;
  time: string;
  status: AppointmentStatus;
  laserParams?: LaserParams;
  anamnesis: Anamnesis;
}

